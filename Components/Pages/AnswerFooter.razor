<div class="answer-footer">
    @if (!string.IsNullOrWhiteSpace(Example))
    {
        <div class="answer-example @(IsCorrect.HasValue ? "" : "example-hidden")"
             aria-hidden="@(!IsCorrect.HasValue ? "true" : "false")">
            <span class="example-label">Example</span>
            <p>
                @foreach (var part in GetExampleParts())
                {
                    @if (string.Equals(part, HighlightWord ?? CorrectAnswer, StringComparison.OrdinalIgnoreCase))
                    {
                        <strong>@part</strong>
                    }
                    else
                    {
                        @part
                    }
                }
            </p>
        </div>
    }

    <div class="footer-actions">
        <div class="answer-counts">
            <span class="answer-count answer-count--total">
                Total <strong>@TotalQuestions</strong>
            </span>
            <span class="answer-count answer-count--correct">
                Correct <strong>@CorrectCount</strong>
            </span>
            <span class="answer-count answer-count--incorrect">
                Incorrect <strong>@IncorrectCount</strong>
            </span>
        </div>
        <button type="button"
                class="next-button"
                @ref="_nextButton"
                @onclick="OnNext"
                disabled="@(!IsCorrect.HasValue)">
            Next
        </button>
    </div>  
</div>

    @code {
    [Parameter] public bool? IsCorrect { get; set; }
    [Parameter] public string CorrectAnswer { get; set; } = string.Empty;
    [Parameter] public string? HighlightWord { get; set; }
    [Parameter] public string? Example { get; set; }
    [Parameter] public EventCallback OnNext { get; set; }
    [Parameter] public int TotalQuestions { get; set; }
    [Parameter] public int CorrectCount { get; set; }
    [Parameter] public int IncorrectCount { get; set; }
    
    private string[] GetExampleParts()
    {
        var text = Example ?? string.Empty;
        var target = HighlightWord ?? CorrectAnswer;

        if (string.IsNullOrWhiteSpace(target))
        {
            return [text];
        }

        var answer = System.Text.RegularExpressions.Regex.Escape(target);
        return System.Text.RegularExpressions.Regex.Split(
            text,
            $@"(?i)(?<!\w)({answer})(?!\w)");
    }
    
    private ElementReference _nextButton;
    private bool _wasAnswered;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var isAnswered = IsCorrect.HasValue;
        var shouldFocusNext = isAnswered && !_wasAnswered;
        _wasAnswered = isAnswered;

        if (shouldFocusNext)
        {
            await _nextButton.FocusAsync();
        }
    }
}