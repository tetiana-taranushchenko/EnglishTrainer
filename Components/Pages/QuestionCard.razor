@using EnglishTrainer.Models

<div class="question-heading">
    @if (IsEnglishPrompt)
    {
        <button type="button"
                class="speak-button"
                title="Listen"
                aria-label="Listen to pronunciation"
                onclick="speakEn(this.nextElementSibling.textContent)">
            🔊
        </button>
    }
    <h2 lang="@Question.PromptLanguage">@Question.PromptText</h2>
    <span class="part-of-speech">@Question.PartOfSpeech</span>
</div>

@if (!string.IsNullOrWhiteSpace(Question.Explanation))
{
    <details class="explanation" @key="Question">
        <summary class="explanation-toggle">Explanation</summary>
        <p class="explanation-text">@Question.Explanation</p>
    </details>
}

<div class="answer-options">
    @foreach (var option in Question.Options)
    {
        var answerClass = GetAnswerClass(option);

        <button type="button"
                class="answer-option @answerClass"
                @onclick="() => OnAnswerSelected.InvokeAsync(option)"
                disabled="@(IsCorrect.HasValue)">
            <span lang="@Question.OptionsLanguage">@option</span>
            <span class="answer-icon" aria-hidden="true">
                @if (answerClass == "answer-correct")
                {
                    <text>✓</text>
                }
                else if (answerClass == "answer-incorrect")
                {
                    <text>✕</text>
                }
            </span>
        </button>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public PracticeQuestion Question { get; set; } = default!;
    
    [Parameter] public bool? IsCorrect { get; set; }
    [Parameter] public string? SelectedAnswer { get; set; }
    [Parameter] public EventCallback<string> OnAnswerSelected { get; set; }

    private bool IsEnglishPrompt =>
        Question.PromptLanguage?.StartsWith("en", StringComparison.OrdinalIgnoreCase) == true;

    private string GetAnswerClass(string option)
    {
        if (!IsCorrect.HasValue)
        {
            return "";
        }

        if (option == Question.CorrectAnswer)
        {
            return "answer-correct";
        }

        return option == SelectedAnswer ? "answer-incorrect" : "";
    }
}