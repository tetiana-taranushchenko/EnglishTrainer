@page "/"
@rendermode InteractiveServer
@using EnglishTrainer.Data
@using EnglishTrainer.Models

<PageTitle>English Trainer</PageTitle>

<div class="practice-page">
    <section class="practice-card">
        @if (_controller.IsComplete)
        {
            <PracticeSummary Answers="@_controller.Session.Answers"
                             OnRestart="_controller.Restart"
                             OnCsvSelected="HandleCsvSelected" />
        }
        else
        {
            <PracticeHeader OnCsvSelected="HandleCsvSelected"
                            Direction="@_controller.Direction"
                            CanSwitchDirection="@_controller.CanSwitchDirection"
                            OnDirectionSwitch="_controller.SwitchDirection"
                            OnHelpRequested="() => _isHelpOpen = true" />
            @if (_controller.HasImportedQuestions)
            {
                <QuestionCard Question="@_controller.Session.CurrentQuestion"
                              IsCorrect="@_controller.IsCorrect"
                              SelectedAnswer="@_controller.SelectedAnswer"
                              OnAnswerSelected="_controller.SelectAnswer" />

                <AnswerFooter IsCorrect="@_controller.IsCorrect"
                              CorrectAnswer="@_controller.Session.CurrentQuestion.CorrectAnswer"
                              HighlightWord="@_controller.Session.CurrentQuestion.EnglishWord"
                              OnNext="_controller.GoToNextQuestion"
                              Example="@_controller.Session.CurrentQuestion.Example"
                              TotalQuestions="@_controller.Session.TotalQuestions"
                              CorrectCount="@_controller.Session.CorrectCount"
                              IncorrectCount="@_controller.Session.IncorrectCount"
                              />
            }
        }
    </section>
</div>

<Toast Message="@_errorMessage" OnDismiss="() => _errorMessage = null" />

<HelpDialog IsOpen="@_isHelpOpen" OnClose="() => _isHelpOpen = false" />
