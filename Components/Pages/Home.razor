@page "/"
@rendermode InteractiveServer
@using EnglishTrainer.Data
@using EnglishTrainer.Models

<PageTitle>English Trainer</PageTitle>

<div class="practice-page">
    <section class="practice-card">
        @if (_isComplete) 
        {
            <PracticeSummary Answers="@_session.Answers"
                             OnRestart="RestartPractice"
                             OnCsvSelected="HandleCsvSelected" />
        }
        else
        {
            <PracticeHeader OnCsvSelected="HandleCsvSelected"
                            Direction="@_direction"
                            CanSwitchDirection="@CanSwitchDirection"
                            OnDirectionSwitch="SwitchDirection" />
            @if (_importedQuestions is not null)
            {
                <QuestionCard Question="@_session.CurrentQuestion"
                              IsCorrect="@_isCorrect"
                              SelectedAnswer="@_selectedAnswer"
                              OnAnswerSelected="SelectAnswer" />

                <AnswerFooter IsCorrect="@_isCorrect"
                              CorrectAnswer="@_session.CurrentQuestion.CorrectAnswer"
                              OnNext="GoToNextQuestion" 
                              Example="@_session.CurrentQuestion.Example"
                              TotalQuestions="@_session.TotalQuestions"
                              CorrectCount="@_session.CorrectCount"
                              IncorrectCount="@_session.IncorrectCount"
                              />
            }
        }
    </section>
</div>

