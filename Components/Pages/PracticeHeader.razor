@using EnglishTrainer.Models
@using Microsoft.AspNetCore.Components.Forms

<header class="practice-header">
    <h1>English Trainer</h1>

    <div class="practice-header-actions">
        <div class="practice-direction">
            <span>
                @(Direction == PracticeDirection.UkrainianToEnglish ? "UA → EN" : "EN → UA")
            </span>

            <button type="button"
                    class="direction-swap"
                    aria-label="Switch practice direction"
                    @onclick="OnDirectionSwitch"
                    disabled="@(!CanSwitchDirection)">
                ⇄
            </button>
        </div>

        <div class="csv-upload">
            <div class="csv-upload-row">
                <button type="button"
                        class="help-trigger"
                        aria-label="Show CSV format help"
                        title="Don't have a file? Get a sample or create one with AI."
                        @onclick="OnHelpRequested">
                    ?
                </button>

                <label class="csv-picker">
                    <span>Upload word list</span>
                    <InputFile @key="_inputKey" OnChange="SelectCsv" accept=".csv" />
                </label>
            </div>

            <p class="csv-file-name" role="status">
                @if (_fileName is not null)
                {
                    <span title="@_fileName">@_fileName</span>
                }
            </p>
        </div>
    </div>
</header>

@code {
    private string? _fileName;
    private int _inputKey;

    [Parameter]
    public PracticeDirection Direction { get; set; } =
        PracticeDirection.UkrainianToEnglish;
    [Parameter]
    public EventCallback<IBrowserFile> OnCsvSelected { get; set; }
    [Parameter]
    public bool CanSwitchDirection { get; set; }

    [Parameter]
    public EventCallback OnDirectionSwitch { get; set; }

    [Parameter]
    public EventCallback OnHelpRequested { get; set; }

    private async Task SelectCsv(InputFileChangeEventArgs args)
    {
        var file = args.File;
        _fileName = file.Name;

        await OnCsvSelected.InvokeAsync(file);
        _inputKey++;
    }
}